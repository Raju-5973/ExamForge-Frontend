# ─── Frontend ───────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
GENERATE_SOURCEMAP=false

# ─── Django Backend ──────────────────────────────────────────────────────────
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (development). Set for PostgreSQL (production).
DATABASE_URL=
POSTGRES_DB=examforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── AI API Keys (at least GROQ_API_KEY is required for AI generation) ──────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── Celery (leave as-is for development, set Redis URL for production) ──────
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=True
